# 依赖与构建产物
node_modules/
dist/

# 发布产物（vsix 归拢到 releases/ 后统一跟踪）
*.vsix
releases/

# 测试产物（test.mjs 每次重建）
tests/.build/

# 免费服务缓存
.npmcache/

# 日志
*.log

# 临时验证脚本（规范：用后即删，兜底忽略）
_debug_*
_tmp_*
_verify_*
_probe*

# Private benchmark/holdout packs must never enter public source control.
.freesek-holdout/
benchmarks/private/
