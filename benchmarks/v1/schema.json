{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freeseek.dev/schemas/bench-v1.json",
  "title": "FreeSeek Bench v1 manifest",
  "type": "object",
  "required": ["version", "name", "cases"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "workspace", "prompt", "category", "difficulty"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "workspace": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "category": { "enum": ["core", "multifile", "context", "security"] },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "allowShell": { "type": "boolean" },
        "allowNetwork": { "type": "boolean" },
        "checks": { "type": "array", "items": { "type": "object", "required": ["type"] } },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxTokens": { "type": "number", "minimum": 0 },
            "maxSteps": { "type": "number", "minimum": 0 },
            "maxToolCalls": { "type": "number", "minimum": 0 },
            "maxDurationMs": { "type": "number", "minimum": 0 },
            "maxApprovalsRequested": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
