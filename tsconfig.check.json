{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "vscode"
    ]
  },
  "include": [
    "src",
    "apps/desktop/src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "webview-out",
    "deepseek-free-api",
    "out"
  ]
}
