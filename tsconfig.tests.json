  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src",
    "tests",
    "apps/desktop/src"
